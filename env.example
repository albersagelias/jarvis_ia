# Copia este archivo como ".env" y rellena tus valores.
# NUNCA subas el archivo .env a GitHub ni lo compartas.

# Proveedor de IA: "anthropic" (nube) u "ollama" (100% local)
PROVEEDOR_IA=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODELO=claude-sonnet-5-5

# --- Ollama (solo si PROVEEDOR_IA=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1

# --- Personalización ---
ASISTENTE_NOMBRE=Jarvis
